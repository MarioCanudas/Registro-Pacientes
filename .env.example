# Cadena de conexión a MongoDB Atlas con usuario de privilegios mínimos (readWrite sobre optaGestionDeDatos)
MONGO_URI="mongodb+srv://usuario_min_priv:REEMPLAZAR_PASSWORD@cluster0.ejemplo.mongodb.net/?retryWrites=true&w=majority"

# Nombre de la base de datos y colección principal
MONGO_DB_NAME="optaGestionDeDatos"
MONGO_COLLECTION_NAME="REGISTRO-PACIENTES"

# Orígenes permitidos para CORS separados por coma (nunca usar "*" en producción)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
